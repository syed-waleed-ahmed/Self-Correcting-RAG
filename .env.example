# Copy to `.env` and fill in your key. Any OpenAI-compatible provider works;
# Groq is the default. The key is read from GROQ_API_KEY, OPENAI_API_KEY, or
# SCRAG_LLM_API_KEY (in that order).
GROQ_API_KEY=your_api_key_here

# --- Optional overrides (all use the SCRAG_ prefix) ------------------------
# Point at a different OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...):
# SCRAG_LLM_BASE_URL=https://api.openai.com/v1
# Defaults verified on Groq's free tier on 2026-11-10. Groq retired the Llama 3.x
# models for free tiers on 2026-08-16; check https://console.groq.com/docs/models
# SCRAG_GENERATOR_MODEL=qwen/qwen3.8-27b
# SCRAG_EVALUATOR_MODEL=qwen/qwen3.8-27b
# SCRAG_GUARDRAIL_MODEL=qwen/qwen3.8-27b
# Reasoning models such as openai/gpt-oss-20b need SCRAG_GUARDRAIL_MAX_TOKENS=256
# SCRAG_GUARDRAIL_MAX_TOKENS=8

# Embeddings
# SCRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SCRAG_EMBEDDING_DIM=384
# Larger batches embed no faster on CPU, and ONNX Runtime keeps the memory the
# largest batch needed (batch 32 added 229 MB; see docs/load-testing.md).
# SCRAG_EMBEDDING_BATCH_SIZE=8

# Vector store: numpy (default) or faiss (needs the `faiss` extra)
# SCRAG_VECTOR_BACKEND=numpy
# SCRAG_DOCS_DIR=data/docs
# SCRAG_INDEX_DIR=data/index

# Embedding backend: auto (fastembed if installed), fastembed or sentence-transformers
# SCRAG_EMBEDDING_BACKEND=auto

# Retrieval / self-correction
# SCRAG_RETRIEVAL_MODE=hybrid
# SCRAG_GUARDRAIL_MODE=batch
# SCRAG_TOP_K=5
# SCRAG_GUARDRAIL_THRESHOLD=0.3
# SCRAG_EVAL_THRESHOLD=0.7
# SCRAG_MAX_SELF_CORRECT_STEPS=2

# API / logging
# SCRAG_API_HOST=0.0.0.0
# SCRAG_API_PORT=8000
# SCRAG_LOG_LEVEL=INFO
# SCRAG_LOG_JSON=false
# Optional shared-secret auth for /query and /ingest (unset = open API).
# When set, send it as `Authorization: Bearer <token>` or `X-API-Key: <token>`.
# SCRAG_API_AUTH_TOKEN=change-me
# Restrict CORS in production (comma/JSON list); defaults to all origins.
# SCRAG_CORS_ALLOW_ORIGINS=["https://your-frontend.example"]
# Largest request body outside uploads (bytes).
# SCRAG_MAX_REQUEST_BYTES=65536

# --- Public demo mode (see docs/deployment.md) -----------------------------
# SCRAG_DEMO_MODE=false
# SCRAG_DEMO_DAILY_QUERY_BUDGET=30
# SCRAG_DEMO_RATE_LIMIT_PER_MINUTE=6
# SCRAG_DEMO_RATE_LIMIT_BURST=3
# Each client's share of the daily budget (an agent run costs SCRAG_AGENT_BUDGET_COST=2).
# SCRAG_DEMO_CLIENT_DAILY_RUNS=10
# Coarse per-client cap on all requests, refused before routing (health exempt).
# SCRAG_DEMO_FLOOD_LIMIT_PER_MINUTE=120
# SCRAG_DEMO_FLOOD_BURST=60
# SCRAG_DEMO_MAX_QUERY_CHARS=300
# SCRAG_DEMO_TOP_K=5
# Behind a reverse proxy (e.g. Render): read the client IP from this header.
# SCRAG_FORWARDED_IP_HEADER=x-forwarded-for
# SCRAG_FORWARDED_IP_HOPS=1

# --- Persistence: sessions, uploads, history (optional; see docs/deployment.md) ---
# Any Postgres with pgvector (Neon Free recommended). Unset = no database.
# SCRAG_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SCRAG_SESSION_TTL_HOURS=24
# SCRAG_SESSION_MAX_DOCUMENTS=5
# SCRAG_UPLOAD_MAX_BYTES=1000000
# SCRAG_PERSISTENCE_MAX_DOCUMENTS=300
# SCRAG_PERSISTENCE_MAX_SESSIONS=1000

# --- Agent tools (see docs/threat-model.md) -----------------------------------------
# Read-only SQL over an in-memory catalog of the sample corpus.
# SCRAG_SQL_TOOL_ENABLED=true
# web_fetch: HTTPS GETs to these hosts only (exact names or "*.example.com").
# Empty (default) disables it. Private and internal addresses are always refused.
# SCRAG_HTTP_TOOL_ALLOWED_HOSTS=["docs.example.com"]
# SCRAG_HTTP_TOOL_MAX_BYTES=200000
# SCRAG_HTTP_TOOL_TIMEOUT_S=8

# --- JWT admin auth (optional; e.g. Supabase Auth) -------------------------------
# SCRAG_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SCRAG_AUTH_ISSUER=https://<project>.supabase.co/auth/v1
# SCRAG_ADMIN_SUBJECTS=["<your user id>"]

# --- Observability (optional) ---------------------------------------------------
# Tracing: none (default) | console | otlp (set OTEL_EXPORTER_OTLP_ENDPOINT). Needs [otel].
# SCRAG_OTEL_EXPORTER=none
# Cost estimates at list prices, USD per million tokens (unpriced models report null):
# SCRAG_LLM_PRICES={"some/model-id": {"input": 0.10, "output": 0.30}}
